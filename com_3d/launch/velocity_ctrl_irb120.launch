<launch>
  <arg name="robot_ip" default="192.168.125.1"/>
  <arg name="rws_username" default="ROS"/>
  <arg name="rws_password" default="robotics"/>
  <arg name="load_robot_description" default="true"/>
  <arg name="debug" default="false"/> <arg name="info" default="true"/> 
  <arg name="netft_ip" default="192.168.126.125"/>
  <arg name="tag_ns" default="cont_detect"/>

  <!-- online estimator config -->
  <arg name="enable_online_estimator" default="true"/>
  <arg name="enable_live_plot" default="true"/>

  <!-- ############################## -->
  <!-- ### Robot Hardware Bringup ### -->
  <!-- ############################## -->

  <!-- Launch the bringup -->
  <include file="$(find com_3d)/launch/bringup_irb120_vel.launch">
    <arg name="robot_ip" value="$(arg robot_ip)"/>
    <arg name="debug" value="$(arg debug)"/>
  </include>


  <!-- Combine EGM state with static frames from xacro (finger+FT)-->
  <param name="robot_description" 
         command="$(find xacro)/xacro '$(find com_3d)/urdf/irb120_with_finger.xacro'" />


  <!-- ############################### -->
  <!-- ## Startup Script (EGM init) ## -->
  <!-- ############################### -->
  <node pkg="com_3d"
        type="egm_handler.py"
        name="EGM_handler"
        output="screen"/>

  <!-- ############################### -->
  <!-- ##### NETFT Sensor Config ##### -->
  <!-- ############################### -->

  <include file="$(find com_3d)/launch/live_netft.launch">
      <arg name="apply_transform" value="false"/> <!-- TRUE -->
      <arg name="apply_bias" value="true"/>
    </include>

  <!-- ############################### -->
  <!-- ### Video & AprilTag Config ### -->
  <!-- ############################### -->

  <!-- USB camera node -->
  <node pkg="usb_cam" type="usb_cam_node" name="usb_cam" output="screen">
    <param name="video_device" value="/dev/video0"/>
    <param name="image_width" value="1920"/>
    <param name="image_height" value="1080"/>
    <param name="pixel_format" value="mjpeg"/>
    <param name="io_method" value="mmap"/>
    <param name="frame_rate" value="30"/> <!-- I think camera specific, leave at 30 for now -->
    <!-- Point to calibration file produced by camera_calibration -->
    <param name="camera_info_url" value="file://$(find com_3d)/config/usb_cam_calibration.yaml"/>
  </node>


  <!-- AprilTag detector (copied from apriltag_ros pkg) -->
  <rosparam command="load" file="$(find com_3d)/config/apriltag_settings.yaml" ns="$(arg tag_ns)" />
  <rosparam command="load" file="$(find com_3d)/config/apriltags.yaml" ns="$(arg tag_ns)" />
  <node pkg="apriltag_ros" type="apriltag_ros_continuous_node" name="$(arg tag_ns)" clear_params="true" output="screen" launch-prefix="" >
    <remap from="image_rect" to="/usb_cam/image_raw" />
    <remap from="camera_info" to="/usb_cam/camera_info" />
    <param name="publish_tag_detections_image" type="bool" value="true" />
  </node>

  <!-- Visualize using rqt_image_viewer -->
  <!-- <node pkg="rqt_image_view" type="rqt_image_view" name="view_tag_overlay" output="screen"
    args="/tag_detections_image">
    <param name="image_transport" value="raw"/>
  </node> -->

  <!-- Shutdown Handler (cleanup on exit) DEACTIVATED FOR NOW, DOESN'T DO ANYTHING-->
  <!-- <node pkg="com_3d" type="shutdown_handler.py" name="shutdown_handler" output="screen"/> -->


  <!-- LAUNCH ALL LOGGERS -->
  <node pkg="com_3d" type="sync_logger.py" name="sync_logger" output="screen" args="-debug">
    <!-- <param name="run_base" value="$(arg run_base)"/> This is the DATE formatted, passed in cmd (see scripts) -->
    <param name="base_frame" value="base_link"/>
    <param name="ee_frame"   value="finger_tip"/>
    <param name="ft_topic"   value="/netft_data_transformed"/>
    <param name="dets_topic_name" value="/tag_detections"/>
    <param name="image_topic"   value="/tag_detections_image"/>
    <!-- video/overlay config -->
    <param name="tag_max_age" value="0.10"/>
    <param name="fps_hint"      value="30"/> <!-- Camera-specific (I think. Stick to 30fps for now.)-->
  </node>

  <!-- Run the FK tip pose publisher -->
  <node pkg="com_3d" type="fk_tip_publisher.py" name="fk_tip_publisher" output="screen"/>


  <!-- ############################### -->
  <!-- #### TRUE STREAMING ESTIMATE ### -->
  <!-- ############################### -->
  <group if="$(arg enable_online_estimator)">
    <node pkg="com_3d" type="streaming_estimator.py" name="streaming_estimator" output="screen">
      <!-- where to read live streams -->
      <param name="ft_stream_topic" value="/netft_data_transformed"/>
      <param name="tag_topic" value="/tag_detections"/>
      <param name="tip_pose_topic" value="/com_3d/tip_pose_fk"/>

      <!-- 500 Hz ingest; estimation uses decimation + fixed window-->
      <param name="fs_hz" value="500"/>
      <param name="est_decimate" value="5"/>
      <param name="est_window_size" value="250"/>
      <param name="est_update_hz" value="5"/>

      <!-- Causal filtering (median + butter LPF). Apply to BOTH force and rotvec -->
      <param name="force_medwin" value="5"/>
      <param name="force_cutoff_hz" value="5.0"/>
      <param name="force_order" value="4"/>
      <param name="rotvec_medwin" value="5"/>
      <param name="rotvec_cutoff_hz" value="5.0"/>
      <param name="rotvec_order" value="4"/>

      <!-- tag frame correction (optional) -->
      <rosparam param="tag_cam_to_world_euler_deg">[0.0, 0.0, 0.0]</rosparam>
    </node>
  </group>

  <!-- ############################### -->
  <!-- ######## LIVE PLOT (GUI) ###### -->
  <!-- ############################### -->

  <node if="$(arg enable_live_plot)"
        pkg="com_3d"
        type="live_fit_plotter.py"
        name="live_fit_plotter"
        output="screen">
    <param name="update_hz" value="5"/>
  </node>
  
</launch>